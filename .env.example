# ============================================================
# Fara Tutorial Guide RAG — 配置模板（提交到仓库，供新用户复制）
# 用法: cp .env.example .env  然后按需修改（.env 已被 gitignore，不会提交）
# 优先级: 终端 export > .env 文件 > scripts/config.py 默认值
# 无 GPU / 外部 OpenAI 端口场景填下面示例即可；全部留空=本地默认(localhost)
# ============================================================

# ---- 外部 Fara（vLLM，OpenAI 兼容）----
FARA_HOST=10.17.83.10
FARA_PORT=8000
FARA_MODEL_NAME=Fara1.5-4B-FP8

# ---- 外部 Checker（Ollama）----
CHECKER_HOST=10.17.83.10
CHECKER_PORT=11434
CHECKER_MODEL_NAME=qwen3.5:0.8b

# ---- 外部 RAG 嵌入（Ollama bge-m3，维度 1024）----
# 若用本地 CPU bge，删除下面 4 行即可（需 pip install sentence-transformers）
EMBEDDING_BACKEND=ollama
EMBEDDING_API_URL=http://10.17.83.10:11434/v1/embeddings
EMBEDDING_MODEL_ID=bge-m3:latest
EMBEDDING_DIM=1024
